; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="XRay Simulator"
config/version="1.0.0"
run/main_scene="res://scenes/MainSimulator.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"
config/run/max_fps=60

[autoload]

DataManager="*res://scripts/Autoload/DataManager.gd"
GameManager="*res://scripts/Autoload/GameManager.gd"
EvaluationLogic="*res://scripts/Gameplay/EvaluationLogic.gd"
SoundManager="*res://scenes/Audio/SoundManager.gd"
PerformanceMonitor="*res://scripts/Debug/PerformanceMonitor.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=false
window/vsync/vsync_mode=1

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
